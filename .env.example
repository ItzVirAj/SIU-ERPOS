# ==============================================================================
# SIU-ERPOS Environment Variables Template (.env.example)
# ==============================================================================

# Better Auth Configuration (Secret must be at least 32 characters in production)
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="your-32-character-or-longer-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Neon / Postgres with SSL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Secret Encryption at Rest (AES-256-GCM for BYOK Groq API keys)
# Generate with: openssl rand -base64 32
# In production, losing this key means re-entering Groq API keys in Settings.
APP_ENCRYPTION_KEY=""
# APP_ENCRYPTION_KEY_PREVIOUS="" # Optional previous key during rotation

# Google OAuth Credentials (Optional: social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Chatbot Integration (Groq Platform Fallback)
GROQ_API_KEY=""

# Email Service (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# Proxy & Client IP Extraction
# Number of reverse proxy hops between clients and Next.js (1..5, default 1 for Render).
# Verification: after deploy sign in and compare the IP shown in your own audit log or session list
# with your real IP. If it shows a proxy address, raise or lower this value.
TRUSTED_PROXY_HOPS="1"

# Session Lifetimes & Absolute Expiry
# Inactivity timeout is 12 hours, active session refreshed every 1 hour, cookie cache 5 minutes.
# ABSOLUTE_SESSION_DAYS enforces hard cutoff regardless of user activity.
ABSOLUTE_SESSION_DAYS="7"

# Login Brute Force Lockout
# LOGIN_MAX_FAILURES="5"
# LOGIN_WINDOW_MINUTES="15"
# LOGIN_LOCK_MINUTES="15"
# LOGIN_LOCK_MAX_MINUTES="60"

# Employee Default Password & Security Policy
# In production: required, 12+ chars, must include uppercase, lowercase, digit, and symbol.
# Never use "Pass@123" in production.
# DEFAULT_PASSWORD="ChangeMe#2026!Secure"
# DEFAULT_PASSWORD_TTL_DAYS="7"
# ALLOW_HARD_DELETE="0" # "0" (default soft delete) or "1" (hard delete permitted)
# ALLOW_PROD_SEED="0"
# OWNER_PASSWORD="" # Required when seeding owner in production; 12+ chars, strong
