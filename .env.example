# ==============================================================================
# SIU-ERPOS Environment Variables Template (.env.example)
# ==============================================================================

# Better Auth Configuration (Secret must be at least 32 characters in production)
BETTER_AUTH_SECRET="your-32-character-or-longer-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Neon / Postgres with SSL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Google OAuth Credentials (Optional: social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Chatbot Integration (Groq)
GROQ_API_KEY=""

# Email Service (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# Employee Default Password & Security Policy (Optional overrides)
# DEFAULT_PASSWORD="ChangeMe@123456"
# DEFAULT_PASSWORD_TTL_DAYS="7"
# ALLOW_HARD_DELETE="false"
# ALLOW_PROD_SEED="0"
# OWNER_PASSWORD=""
